# Keep the Docker build context small and reproducible: exclude host build
# artifacts so the extension is always compiled fresh inside the target image.
.git
.github
.gitlab-ci.yml
.travis.yml
.appveyor.yml

# phpize / autotools generated output (rebuilt inside the image)
build/
.libs/
modules/
autom4te.cache/
configure
config.h
config.h.in
config.log
config.status
config.nice
libtool
Makefile
Makefile.fragments
Makefile.objects
*.la
*.lo
*.lai
*.o
*.so
*.dep

# packaging / report artifacts
*.tgz
ci/report-project/vendor/
ci/report-project/build/

# docs and k8s are not needed to build the extension
k8s/
